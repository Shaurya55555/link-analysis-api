# LLM provider: "gemini" (default), "openai" or "anthropic" (any OpenAI-compatible API: OpenAI, Groq, OpenRouter...)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Only needed for LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
# Only needed for LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Max analyses per client IP per hour (protects the API key on a public deployment)
RATE_LIMIT_PER_HOUR=20
# Optional fallback provider used if the primary fails
FALLBACK_PROVIDER=
# Tuning
FETCH_TIMEOUT_S=10
MAX_HTML_BYTES=2000000
MAX_CONTENT_CHARS=12000
CACHE_TTL_S=3600
