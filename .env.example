# LLM provider: "gemini" (default) or "openai" (any OpenAI-compatible API: OpenAI, Groq, OpenRouter...)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Only needed for LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
# Optional fallback provider used if the primary fails
FALLBACK_PROVIDER=
# Tuning
FETCH_TIMEOUT_S=10
MAX_HTML_BYTES=2000000
MAX_CONTENT_CHARS=12000
CACHE_TTL_S=3600
